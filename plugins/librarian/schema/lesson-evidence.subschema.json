{
  "type": "object",
  "properties": {
    "artifact_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "session_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "project_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "resolution": {
      "type": "string",
      "minLength": 1
    },
    "observed_on": {
      "description": "Keyed by stack entry. Every key must be in applies_to.stack.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": ["lockfile", "manifest", "mise", "workflow", "component", "probe"]
          },
          "basis": {
            "type": "string",
            "enum": ["session_commit", "head", "machine"]
          },
          "flavor": {
            "type": "string",
            "enum": ["gnu", "bsd"]
          }
        },
        "required": ["version", "source", "basis"],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "description": "Stack entries no source could version. An entry that was observed but whose version yields no range belongs in observed_on, not here.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": ["artifact_ids", "session_ids", "project_key", "observed_at", "resolution"],
  "additionalProperties": false
}
