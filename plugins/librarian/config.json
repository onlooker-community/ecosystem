{
  "plugin_name": "librarian",
  "storage_path": "~/.onlooker",
  "librarian": {
    "auto_promote": false,
    "auto_promote_threshold": 0.85,
    "memory_store_path": "${HOME}/.claude/projects/${CLAUDE_PROJECT_ENCODED}/memory",
    "scan": {
      "trigger": "SessionEnd",
      "bootstrap_lookback_days": 14,
      "min_detail_chars": 40
    },
    "classifier": {
      "model": "claude-haiku-4-5-20251001",
      "temperature": 0.2,
      "max_output_tokens": 256,
      "min_classifier_confidence": 0.6
    },
    "lesson_transform": {
      "model": "claude-haiku-4-5-20251001",
      "timeout_seconds": 20
    },
    "lesson_judging": {
      "rubrics": [
        {
          "id": "lesson-promotion",
          "criteria": [
            { "name": "grounding", "weight": 0.45, "min_pass": 0.7 },
            { "name": "scope_accuracy", "weight": 0.35, "min_pass": 0.7 },
            { "name": "generality", "weight": 0.2, "min_pass": 0.6 }
          ],
          "score_threshold": 0.75,
          "judge_types": ["standard", "adversarial"],
          "gate_policy": "majority"
        },
        {
          "id": "lesson-promotion-public",
          "criteria": [
            { "name": "grounding", "weight": 0.32, "min_pass": 0.7 },
            { "name": "scope_accuracy", "weight": 0.24, "min_pass": 0.7 },
            { "name": "generality", "weight": 0.14, "min_pass": 0.6 },
            { "name": "disclosure", "weight": 0.3, "min_pass": 0.9 }
          ],
          "score_threshold": 0.75,
          "judge_types": ["standard", "adversarial"],
          "gate_policy": "unanimous"
        }
      ]
    },
    "durability_filter": {
      "marker_phrases": [
        "always",
        "never",
        "remember",
        "from now on",
        "every time",
        "whenever",
        "prefer",
        "the reason",
        "because",
        "historically",
        "legacy",
        "compliance",
        "requirement"
      ],
      "require_grounding": false,
      "repetition_min_sessions": 2
    },
    "conflict": {
      "duplicate_threshold": 0.7,
      "merge_candidate_threshold": 0.45,
      "conflict_keyword_overlap": 0.5
    },
    "surfacer": {
      "max_pending_for_inject": 20,
      "skip_inject_when_zero": true
    },
    "tombstones": {
      "ttl_days": 180
    }
  }
}
