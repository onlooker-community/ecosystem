{
  "plugin_name": "echo",
  "storage_path": "~/.onlooker",
  "echo": {
    "watch_paths": [
      ".claude/agents/*.md",
      ".claude/commands/*.md",
      ".claude/skills/*/SKILL.md",
      ".agents/*.md",
      ".agents/skills/*/SKILL.md",
      "agents/*.md",
      "skills/*/SKILL.md",
      "plugins/*/agents/*.md",
      "plugins/*/commands/*.md",
      "plugins/*/skills/*/SKILL.md"
    ],
    "exclude_paths": [],
    "drift_threshold": 0.05,
    "evaluation": {
      "model": "claude-haiku-4-5-20251001",
      "max_output_tokens": 512,
      "timeout_seconds": 60
    }
  }
}
